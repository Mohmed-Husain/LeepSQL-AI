# LeepSQL-AI Environment Variables
# Copy this file to .env and fill in your values

# Google AI API Key (Required for AI agents)
GOOGLE_API_KEY=your_google_api_key_here

# Application Settings (Optional - defaults are provided)
DEBUG=false
LOG_LEVEL=INFO

# Frontend Configuration (Required for Docker build)
# API URL - Use /api for Docker (nginx proxies to agents), or full URL for external
VITE_API_BASE_URL=/api

# Supabase Configuration (for chat history persistence)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
