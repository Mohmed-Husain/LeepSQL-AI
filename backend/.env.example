# Environment Configuration for LeepSQL-AI Backend
# Copy this file to .env and configure for your environment
# NEVER commit .env to version control

# AI Agent Service
AI_AGENT_URL=http://localhost:9000/process
AI_AGENT_TIMEOUT=30

# Database Query Limits
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT=30

# Session Management
SESSION_CLEANUP_INTERVAL=3600
SESSION_MAX_IDLE_TIME=1800

# Security - CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=app/logs/audit.log

# Application
DEBUG=False
