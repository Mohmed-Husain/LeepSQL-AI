    {
      "id": "XeScwhzgSjX6EkQQlksQx",
      "type": "text",
      "x": -2220.632729625783,
      "y": -1546.3365234005198,
      "width": 2438.4282395264204,
      "height": 2079.9572271939287,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 1753842790,
      "version": 1239,
      "versionNonce": 128188280,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768027516350,
      "link": null,
      "locked": false,
      "text": "Target Users\nPrimary Users:\n\n1. Business Analysts & Data Analysts\n\nFocus on figures and not numbers\nNeed quick database insights without writing SQL\nWant to explore data independently without waiting for IT/developers\n\n2. Non-Technical Stakeholders (Management, Product Managers, Marketing Teams)\n\nNeed data-driven decisions but lack SQL knowledge\nWant real-time answers to business questions\nCurrently depend on technical teams for simple queries\n\n\n3. Junior Developers & Interns\n\nLearning database operations\nNeed assistance with complex SQL syntax\nBenefit from seeing AI-generated queries (educational aspect)\n\n\nSecondary Users:\n\n4. Customer Support Teams\n\nNeed to quickly look up customer information\nHandle data requests without developer involvement\nDeveloper mode ensures they can't accidentally harm data\n\n\n5. Small Business Owners\n\nManage their own databases\nCan't afford full-time database administrators\nNeed simple, safe database access\n\n\n\n",
      "fontSize": 40.584531262320574,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Target Users\nPrimary Users:\n\n1. Business Analysts & Data Analysts\n\nFocus on figures and not numbers\nNeed quick database insights without writing SQL\nWant to explore data independently without waiting for IT/developers\n\n2. Non-Technical Stakeholders (Management, Product Managers, Marketing Teams)\n\nNeed data-driven decisions but lack SQL knowledge\nWant real-time answers to business questions\nCurrently depend on technical teams for simple queries\n\n\n3. Junior Developers & Interns\n\nLearning database operations\nNeed assistance with complex SQL syntax\nBenefit from seeing AI-generated queries (educational aspect)\n\n\nSecondary Users:\n\n4. Customer Support Teams\n\nNeed to quickly look up customer information\nHandle data requests without developer involvement\nDeveloper mode ensures they can't accidentally harm data\n\n\n5. Small Business Owners\n\nManage their own databases\nCan't afford full-time database administrators\nNeed simple, safe database access\n\n\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "mEinu5O65GAkUSU0hhZPR",
      "type": "text",
      "x": -2226.206514917427,
