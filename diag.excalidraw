    {
      "id": "XeScwhzgSjX6EkQQlksQx",
      "type": "text",
      "x": -2023.7736555792628,
      "y": -573.301566102028,
      "width": 1403.929152975829,
      "height": 1226.747130778831,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 1753842790,
      "version": 435,
      "versionNonce": 2109486650,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1768024609840,
      "link": null,
      "locked": false,
      "text": "Target Users\nPrimary Users:\n\n1. Business Analysts & Data Analysts\n\nNeed quick database insights without writing SQL\nWant to explore data independently without waiting for IT/developers\nFocus on analysis, not syntax\n\n\n2. Non-Technical Stakeholders (Management, Product Managers, Marketing Teams)\n\nNeed data-driven decisions but lack SQL knowledge\nWant real-time answers to business questions\nCurrently depend on technical teams for simple queries\n\n\n3. Junior Developers & Interns\n\nLearning database operations\nNeed assistance with complex SQL syntax\nBenefit from seeing AI-generated queries (educational aspect)\n\n\nSecondary Users:\n\n4. Customer Support Teams\n\nNeed to quickly look up customer information\nHandle data requests without developer involvement\nDeveloper mode ensures they can't accidentally harm data\n\n\n5. Small Business Owners\n\nManage their own databases\nCan't afford full-time database administrators\nNeed simple, safe database access\n\n\n\n",
      "fontSize": 23.366612014834875,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Target Users\nPrimary Users:\n\n1. Business Analysts & Data Analysts\n\nNeed quick database insights without writing SQL\nWant to explore data independently without waiting for IT/developers\nFocus on analysis, not syntax\n\n\n2. Non-Technical Stakeholders (Management, Product Managers, Marketing Teams)\n\nNeed data-driven decisions but lack SQL knowledge\nWant real-time answers to business questions\nCurrently depend on technical teams for simple queries\n\n\n3. Junior Developers & Interns\n\nLearning database operations\nNeed assistance with complex SQL syntax\nBenefit from seeing AI-generated queries (educational aspect)\n\n\nSecondary Users:\n\n4. Customer Support Teams\n\nNeed to quickly look up customer information\nHandle data requests without developer involvement\nDeveloper mode ensures they can't accidentally harm data\n\n\n5. Small Business Owners\n\nManage their own databases\nCan't afford full-time database administrators\nNeed simple, safe database access\n\n\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "mEinu5O65GAkUSU0hhZPR",
      "type": "text",
      "x": -1374.780589435105,
      "y": 683.1832628131053,
      "width": 2843.473956468261,
      "height": 199.17048107699515,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aw",
      "roundness": null,
      "seed": 2115611238,
      "version": 212,
      "versionNonce": 1878333990,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1768024437664,
      "link": null,
      "locked": false,
      "text": "\"Imagine a marketing manager needs to know 'How many customers signed up last month from India?' Instead \nof creating a ticket for the data team and waiting 2 days, they type that question, \nour AI generates SELECT COUNT(*) FROM customers WHERE signup_date >= '2024-12-01' AND country = 'India', the validator checks it's safe,\n and they get their answer in 5 seconds.\"",
      "fontSize": 39.834096215399015,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Imagine a marketing manager needs to know 'How many customers signed up last month from India?' Instead \nof creating a ticket for the data team and waiting 2 days, they type that question, \nour AI generates SELECT COUNT(*) FROM customers WHERE signup_date >= '2024-12-01' AND country = 'India', the validator checks it's safe,\n and they get their answer in 5 seconds.\"",
      "autoResize": false,
      "lineHeight": 1.25
    },
